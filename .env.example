# Copy to .env and adjust. Every setting is optional; see README for the full list.
OLLAMA_URL=http://localhost:11434
TEV_MODEL=tev1
EXTRACTOR_MODEL=qwen3.5:4b
PIPELINE_RATE_CALLS=30
PIPELINE_RATE_SECONDS=60
CLASSIFY_RATE_CALLS=120
CLASSIFY_RATE_SECONDS=60
MAX_UPLOAD_MB=20
MAX_PAGES=10
DOCLING_DEVICE=auto
DOCLING_THREADS=4
# DOCLING_ARTIFACTS_PATH=models/docling
LOG_LEVEL=INFO
LOG_JSON=true
